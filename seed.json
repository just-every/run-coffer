{
  "id": "coffer",
  "name": "Coffer",
  "version": "0.1.1",
  "maturity": "first release; independently gated on a computer and a hosted Cloudflare Worker on 18 October 2026",
  "category": "fundraising",
  "spine": {
    "id": "foundation",
    "record": "No domain record selected"
  },
  "description": "Owner-run donor records and giving for a US nonprofit: donors and households, an immutable gift ledger with pledges and soft credits, Stripe card and monthly gifts, emailed receipts, letters and year-end statements, and reviewed move-in from saved export files.",
  "capabilities": [
    {
      "id": "http-dispatch",
      "clauses": [
        "HTTP-001",
        "DONOR-001",
        "GIFT-001",
        "CONSENT-001",
        "ACK-001",
        "APPEAL-001",
        "AGENT-001",
        "IMPORT-001",
        "DATA-001",
        "DONOR-011",
        "GIFT-004",
        "TEAM-003",
        "DONOR-006"
      ]
    }
  ],
  "nonGoals": [
    "US bank (ACH) checkout, PayPal, Venmo and text-to-give",
    "Sending notes to the family for tribute gifts",
    "A live QuickBooks Online connection",
    "Native phone apps",
    "Prospect research, grants and planned giving",
    "Tax advice or non-cash gift valuation"
  ],
  "externals": [
    {
      "id": "cloudflare",
      "required": true,
      "why": "Worker hosting",
      "data": [
        "HTTP requests"
      ],
      "adapters": []
    }
  ],
  "env": [],
  "deploy": {
    "healthPath": "/health",
    "publicPaths": [
      "/",
      "/health",
      "/signin"
    ],
    "notes": "Native owner sessions guard /app and /api/coffer; unknown paths return real 404s; development and demo mail is suppressed."
  },
  "extensionPoints": {
    "contributions": [],
    "policies": [],
    "events": [],
    "slots": [],
    "adapters": []
  },
  "limits": {
    "status": "unmeasured"
  },
  "accessibility": {
    "level": "WCAG 2.2 AA",
    "status": "target; unaudited"
  },
  "operatingCost": {
    "status": "unmeasured"
  },
  "composition": {
    "base": "base",
    "family": "nonprofit",
    "edition": "coffer",
    "modules": [
      "delivery-producer",
      "job-queue",
      "release",
      "deploy-kit",
      "container",
      "demo-host",
      "demo",
      "integrations",
      "mail",
      "ai",
      "portability",
      "d1-transport",
      "erasure",
      "dependencies",
      "operator-auth",
      "owner-claim"
    ]
  },
  "replaces": [
    "Little Green Light",
    "Bloomerang"
  ]
}
