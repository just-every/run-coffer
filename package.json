{
  "name": "@nonprofit/coffer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.20.0"
  },
  "scripts": {
    "build": "rer build",
    "dev": "rer dev",
    "preview": "rer preview",
    "typecheck": "tsc --build --incremental",
    "verify": "rer verify",
    "setup": "rer setup",
    "deploy": "rer deploy",
    "test:runtime": "rer queue test:runtime -- sh -c \"node tests/runtime.mjs\"",
    "onboard": "node scripts/install.mjs",
    "build:app": "rer queue build:app -- sh -c \"vite build\"",
    "verify:app": "node scripts/verify-app.mjs",
    "reset": "rer reset",
    "export": "rer export",
    "import": "rer import",
    "release": "rer release",
    "doctor": "rer doctor",
    "describe": "rer describe",
    "check": "rer check",
    "deps": "rer install",
    "rer": "rer",
    "test:coffer": "node --test --test-concurrency=1 tests/coffer.test.mjs tests/demo.test.mjs",
    "test:site": "node --test tests/site/*.test.mjs",
    "test:giving": "node --test tests/giving.test.mjs",
    "test:receipts": "node --test tests/receipts.test.mjs",
    "test:payments": "node --test tests/payments.test.mjs",
    "test:donor-depth": "node --test --test-concurrency=1 tests/soft-credits.test.mjs tests/pledges.test.mjs",
    "test:pipeline": "node --test tests/pipeline.test.mjs",
    "test:move-in": "node --test --test-concurrency=1 tests/move-in.test.mjs",
    "test:communications": "node --test tests/communications.test.mjs",
    "test:agent": "node --test --test-concurrency=1 tests/agent-*.test.mjs tests/stewardship.test.mjs"
  },
  "dependencies": {
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-start": "1.168.60",
    "fflate": "0.8.3",
    "hono": "4.13.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "read-excel-file": "9.3.12"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.5",
    "@cloudflare/workers-types": "5.20260908.1",
    "@playwright/test": "1.63.0",
    "@runeditrun/rer": "0.2.52",
    "@types/node": "22.20.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "esbuild": "0.28.1",
    "marked": "18.0.14",
    "miniflare": "5.20260907.0-alpha",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "wrangler": "4.129.1"
  },
  "packageManager": "pnpm@10.12.4",
  "pnpm": {
    "overrides": {
      "sharp": "0.35.5",
      "undici": "7.29.1",
      "source-map-js": "1.2.2"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  },
  "license": "MIT",
  "repository": "https://github.com/just-every/run-coffer"
}
