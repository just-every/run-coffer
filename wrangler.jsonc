{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nonprofit-coffer",
  "main": "src/server.ts",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "foundation",
      "database_id": "local-foundation-only",
      "migrations_dir": "migrations/core"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "coffer-files"
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "vars": {
    "AUTH_ORIGIN": "",
    "AUTH_LOCAL": "false"
  }
}
