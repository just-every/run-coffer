{
  "version": 1,
  "project": "nonprofit/coffer",
  "compatibilityDate": "2026-09-08",
  "compatibilityFlags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "d1": [
    {
      "binding": "DB"
    }
  ],
  "r2": [
    {
      "binding": "FILES"
    }
  ],
  "originVar": "AUTH_ORIGIN",
  "vars": {
    "AUTH_LOCAL": "false"
  },
  "secrets": [
    {
      "binding": "OWNER_EMAIL",
      "environment": "OWNER_EMAIL",
      "label": "Owner email"
    },
    {
      "binding": "SESSION_SECRET",
      "environment": "SESSION_SECRET",
      "label": "Session secret"
    },
    {
      "binding": "SETUP_TOKEN",
      "environment": "SETUP_TOKEN",
      "label": "Setup token"
    },
    {
      "binding": "MAIL_API_KEY",
      "environment": "MAIL_API_KEY",
      "label": "Mail API key"
    },
    {
      "binding": "STRIPE_SECRET_KEY",
      "environment": "STRIPE_SECRET_KEY",
      "optional": true
    },
    {
      "binding": "STRIPE_WEBHOOK_SECRET",
      "environment": "STRIPE_WEBHOOK_SECRET",
      "optional": true
    },
    {
      "binding": "MAIL_PROVIDER",
      "environment": "MAIL_PROVIDER",
      "verifyStandIn": "resend",
      "label": "Mail provider"
    },
    {
      "binding": "MAIL_FROM",
      "environment": "MAIL_FROM",
      "verifyStandIn": "auth@example.test",
      "label": "Sender address"
    },
    {
      "binding": "MAIL_EVENT_PUBLIC_KEY",
      "environment": "MAIL_EVENT_PUBLIC_KEY",
      "optional": true
    },
    {
      "binding": "PANTRY_ORIGIN",
      "environment": "PANTRY_ORIGIN",
      "optional": true
    },
    {
      "binding": "PANTRY_AGENT_TOKEN",
      "environment": "PANTRY_AGENT_TOKEN",
      "optional": true
    },
    {
      "binding": "PANTRY_DEPOSIT_ACCOUNT",
      "environment": "PANTRY_DEPOSIT_ACCOUNT",
      "optional": true
    },
    {
      "binding": "PANTRY_FEE_ACCOUNT",
      "environment": "PANTRY_FEE_ACCOUNT",
      "optional": true
    },
    {
      "binding": "PANTRY_FUND_ACCOUNTS",
      "environment": "PANTRY_FUND_ACCOUNTS",
      "optional": true
    },
    {
      "binding": "QBO_ACCOUNT_NAMES",
      "environment": "QBO_ACCOUNT_NAMES",
      "optional": true
    },
    {
      "binding": "QBO_CLIENT_ID",
      "environment": "QBO_CLIENT_ID",
      "optional": true
    },
    {
      "binding": "QBO_CLIENT_SECRET",
      "environment": "QBO_CLIENT_SECRET",
      "optional": true
    },
    {
      "binding": "QBO_SANDBOX",
      "environment": "QBO_SANDBOX",
      "optional": true
    },
    {
      "binding": "COFFER_REPLY_ADDRESS",
      "environment": "COFFER_REPLY_ADDRESS",
      "optional": true
    },
    {
      "binding": "MAIL_RELAY_URL",
      "environment": "MAIL_RELAY_URL",
      "optional": true
    },
    {
      "binding": "MAIL_ACCOUNT_ID",
      "environment": "MAIL_ACCOUNT_ID",
      "optional": true
    }
  ],
  "crons": [
    "* * * * *"
  ]
}
